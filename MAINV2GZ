        local part = getBossPart()
        local hrp = player.Character and player.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
        if part and hrp then
            hrp.CFrame = behindCF(part, 10)
            return true
        end
        return false
    end

