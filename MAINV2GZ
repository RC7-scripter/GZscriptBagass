    -- posisi BELAKANG boss yang SEBENAR (model diputar 180, jadi belakang = -Z / LookVector)
    local function behindCF(bp, dist)
        return bp.CFrame * CFrame.new(0, 2, -dist)
    end

    -- CF selamat untuk dodge: lari ke arah BERTENTANGAN dengan serangan
    -- (guna BossAttackCFrame kalau ada, kalau tak guna belakang visual boss)
    local function safeDodgeCF(bp, model, dist)
        local dir = nil
        if model then
            local atkCf = model:GetAttribute(ATTACK_CFRAME_ATTR)
            if typeof(atkCf) == loadstring(base64decode("Q0ZyYW1l"))() then
                local away = bp.Position - atkCf.Position
                local flat = Vector3.new(away.X, 0, away.Z)
                if flat.Magnitude > 2 then
                    dir = flat.Unit
                end
            end
        end
        if not dir then
            dir = bp.CFrame.LookVector -- belakang visual boss (sebab model diputar 180)
        end
        local pos = bp.Position + dir * dist
        return CFrame.lookAt(pos, Vector3.new(bp.Position.X, pos.Y, bp.Position.Z))
    end

