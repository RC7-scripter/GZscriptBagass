local function tryUseKey(key)
    if not isKeyValid(key) then return false, loadstring(base64decode("S2V5IFNhbGFoIQ=="))() end

    local me = tostring(player.UserId)
    local list = keyBinds[key] or {}

    for _, uid in ipairs(list) do
        if uid == me then return true end
    end

    if #list >= MAX_ACCOUNTS_PER_KEY then
        return false, loadstring(base64decode("S2V5IGluaSBkYWggZGlndW5ha2FuIHBhZGEg"))() .. MAX_ACCOUNTS_PER_KEY .. loadstring(base64decode("IGFjY291bnQh"))()
    end

