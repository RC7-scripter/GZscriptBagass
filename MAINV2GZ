    -- SMART DODGE (tinggi macam versi mantap):
    -- kotak merah (Punch) -> glide MULUS ke arah BERTENTANGAN serangan
    --   (BossAttackCFrame), 60 stud TINGGI searas boss -> kotak merah tak sampai
    --   punch TERUS jalan sebab masih dalam jangkauan hit 90+
    -- bulatan kuning (Stomp) -> glide LAJU ke ATAS boss, punch pause
    -- balik ke boss pun glide mulus
    Boss:AddToggle(loadstring(base64decode("U21hcnQgRG9kZ2U="))(), GZ.smartDodge, function(v)
        GZ.smartDodge = v
        if v then
            task.spawn(function()
                local lastSeq = nil
                while GZ.smartDodge and GZ.running do
                    task.wait(0.05) -- PENTING: yield supaya tak freeze

                    local model = findBossModel()
                    if model then
                        local kind = model:GetAttribute(ATTACK_KIND_ATTR)
                        local impact = tonumber(model:GetAttribute(ATTACK_IMPACT_ATTR))
                        local seq = model:GetAttribute(ATTACK_SEQ_ATTR)
                        local now = Workspace:GetServerTimeNow()

                        if type(kind) == loadstring(base64decode("c3RyaW5n"))() and kind ~= loadstring(base64decode(""))() and impact
                        and seq ~= lastSeq and now < impact + 0.5 then
                            lastSeq = seq

                            if kind == loadstring(base64decode("U3RvbXA="))() then
                                -- bulatan kuning: glide LAJU naik ke atas boss
                                GZ.dodging = true
                                for i = 1, 6 do
                                    if not GZ.smartDodge then break end
                                    local b = getBossPart()
                                    local h = player.Character and player.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
                                    if b and h then
                                        pcall(function()
                                            h.CFrame = h.CFrame:Lerp(CFrame.new(b.Position + Vector3.new(0, GZ.dodgeHeight or 130, 0)), i / 6)
                                            h.AssemblyLinearVelocity = Vector3.zero
                                        end)
                                    end
                                    task.wait(0.05)
                                end
                            else
                                -- kotak merah: glide MULUS ke arah selamat TINGGI searas boss
                                GZ.retreating = true
                                for i = 1, 8 do
                                    if not GZ.smartDodge then break end
                                    local b = getBossPart()
                                    local h = player.Character and player.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
                                    if b and h then
                                        pcall(function()
                                            h.CFrame = h.CFrame:Lerp(safeDodgeCF(b, model, GZ.dodgeBack or 60), i / 8)
                                            h.AssemblyLinearVelocity = Vector3.zero
                                        end)
                                    end
                                    task.wait(0.05)
                                end
                            end

                            -- tunggu impact habis, kekal di posisi selamat (ikut boss kalau dia bergerak)
                            while GZ.smartDodge and GZ.running and model.Parent do
                                local now2 = Workspace:GetServerTimeNow()
                                local imp2 = tonumber(model:GetAttribute(ATTACK_IMPACT_ATTR))
                                if not imp2 or now2 > imp2 + 0.4 then break end

                                local b2 = getBossPart()
                                local h2 = player.Character and player.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
                                if b2 and h2 then
                                    pcall(function()
                                        if kind == loadstring(base64decode("U3RvbXA="))() then
                                            h2.CFrame = CFrame.new(b2.Position + Vector3.new(0, GZ.dodgeHeight or 130, 0))
                                        else
                                            h2.CFrame = safeDodgeCF(b2, model, GZ.dodgeBack or 60)
                                        end
                                        h2.AssemblyLinearVelocity = Vector3.zero
                                    end)
                                end
                                task.wait(0.05)
                            end

                            -- impact habis: glide MULUS balik ke belakang boss
